# Keep the build context small: only sources, manifests and instance data are needed.

# VCS and editor state
.git
.gitignore
.idea
.vscode

# Rust build output
target
**/target
**/*.rs.bk

# Nix / direnv output
result
result-*
.direnv

# Python caches and virtualenvs
**/__pycache__
**/*.py[cod]
.ruff_cache
.pytest_cache
.venv
venv

# Experiment artefacts (regenerated by the pipeline)
**/robo_run
**/experiments_robo
**/results
**/results_*
**/trajectory_exports
**/results_robo.csv

# Upstream Robotics-Benchmarking checkout auto-cloned by preprocessing.fetch_benchmark
**/external

# Local secrets
.env
